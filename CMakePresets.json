{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "developer-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "ORM_CXX_BUILD_TESTS": true,
                "ORM_CXX_BUILD_EXAMPLES": true,
                "ORM_CXX_WARNINGS_AS_ERRORS": true
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-13",
                "CMAKE_CXX_COMPILER": "g++-13"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-18",
                "CMAKE_CXX_COMPILER": "clang++-18"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-coverage",
            "displayName": "Linux Clang Coverage",
            "inherits": "linux-clang-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_COVERAGE": true,
                "LLVM_COV_PATH": "/usr/bin/llvm-cov-18",
                "LLVM_PROFDATA_PATH": "/usr/bin/llvm-profdata-18"
            }
        },
        {
            "name": "linux-gcc-postgresql",
            "displayName": "Linux GCC with PostgreSQL",
            "inherits": "linux-gcc-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        },
        {
            "name": "linux-clang-postgresql-coverage",
            "displayName": "Linux Clang PostgreSQL Coverage",
            "inherits": "linux-clang-coverage",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/externals/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-postgresql-debug",
            "displayName": "MSVC Debug with PostgreSQL",
            "inherits": "msvc-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": false,
                "VCPKG_MANIFEST_FEATURES": "postgresql"
            }
        },
        {
            "name": "quality",
            "displayName": "Clang quality analysis database",
            "inherits": "linux-clang-debug",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true
            }
        },
        {
            "name": "clang-libc++",
            "displayName": "Clang with libc++",
            "description": "Optional compatibility build with Clang and libc++",
            "inherits": "linux-clang-debug",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
                "CMAKE_INCLUDE_PATH": "/usr/lib/llvm-18/include/c++/v1",
                "CMAKE_LIBRARY_PATH": "/usr/lib/llvm-18/lib"
            }
        },
        {
            "name": "linux-gcc-14-debug",
            "displayName": "Linux GCC 14 Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-14",
                "CMAKE_CXX_COMPILER": "g++-14"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-19-debug",
            "displayName": "Linux Clang 19 Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-19",
                "CMAKE_CXX_COMPILER": "clang++-19"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-19-coverage",
            "displayName": "Linux Clang 19 Coverage",
            "inherits": "linux-clang-19-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_COVERAGE": true,
                "LLVM_COV_PATH": "/usr/bin/llvm-cov-19",
                "LLVM_PROFDATA_PATH": "/usr/bin/llvm-profdata-19"
            }
        },
        {
            "name": "linux-gcc-14-postgresql",
            "displayName": "Linux GCC 14 with PostgreSQL",
            "inherits": "linux-gcc-14-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        },
        {
            "name": "linux-clang-19-postgresql-coverage",
            "displayName": "Linux Clang 19 PostgreSQL Coverage",
            "inherits": "linux-clang-19-coverage",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        },
        {
            "name": "linux-clang-19-postgresql",
            "displayName": "Linux Clang 19 with PostgreSQL",
            "inherits": "linux-clang-19-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        },
        {
            "name": "linux-clang-20-debug",
            "displayName": "Linux Clang 20 Debug",
            "inherits": "developer-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-20",
                "CMAKE_CXX_COMPILER": "clang++-20"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-clang-20-postgresql",
            "displayName": "Linux Clang 20 with PostgreSQL",
            "inherits": "linux-clang-20-debug",
            "cacheVariables": {
                "ORM_CXX_ENABLE_POSTGRESQL_BACKEND": true,
                "ORM_CXX_ENABLE_POSTGRESQL_INTEGRATION_TESTS": true
            }
        }
    ],
    "buildPresets": [
