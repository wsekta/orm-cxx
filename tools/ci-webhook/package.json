{
  "name": "codex-ci-webhook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:bridge": "node --test test/bridge.test.mjs test/journal.test.mjs test/dispatcher.test.mjs test/dispatcher-lock.test.mjs test/drain.test.mjs test/registration-cli.test.mjs test/app-server.test.mjs test/desktop.test.mjs test/desktop-start.test.mjs",
    "test:transport": "node --test test/transport.test.mjs",
    "dev": "wrangler dev",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "bridge": "node bridge/main.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
