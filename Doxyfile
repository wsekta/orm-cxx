# Doxygen 1.18.0. Run python scripts/check_docs.py for the checked build.
# Tool and theme versions are pinned in tools/docs-toolchain.json.

PROJECT_NAME           = "ORM C++"
DOXYFILE_ENCODING      = UTF-8
INPUT                  = docs/ modules/ CONTRIBUTING.md ROADMAP.md
FILE_PATTERNS          = *.cppm *.md
EXTENSION_MAPPING      = cppm=C++
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/main.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
EXCLUDE_PATTERNS       = */reflection/generated/* \
                         */orm/internal.cppm \
                         */orm/migrations/internal.cppm
EXCLUDE_SYMBOLS        = *::detail *::detail::*

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
AUTOLINK_SUPPORT       = NO
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = YES
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
PAGE_OUTLINE_PANEL     = NO
HTML_COLORSTYLE        = LIGHT
# check_docs.py supplies absolute paths to the pinned theme.
HTML_EXTRA_STYLESHEET  =
GENERATE_XML           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
