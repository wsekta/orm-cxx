@PACKAGE_INIT@

if(CMAKE_VERSION VERSION_LESS 3.31)
    message(FATAL_ERROR "orm-cxx requires CMake 3.31 or newer.")
endif()
# CMake 3.31 loses nested imported-module dependencies after the first configuration. Use separate Ninja builds for
# Debug and Release so orm can import orm.reflection.
if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
    message(FATAL_ERROR "orm-cxx modules require Ninja.")
endif()
execute_process(
    COMMAND "${CMAKE_MAKE_PROGRAM}" --version
    OUTPUT_VARIABLE orm_cxx_ninja_version
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY
)
if(orm_cxx_ninja_version VERSION_LESS 1.11)
    message(FATAL_ERROR "orm-cxx modules require Ninja 1.11 or newer.")
endif()
if((CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 15)
   OR (CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 18)
   OR (MSVC AND MSVC_VERSION LESS 1950)
)
    message(FATAL_ERROR "orm-cxx requires GCC 15+, Clang 18+, or MSVC 19.50+.")
endif()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|MSVC)$")
    message(FATAL_ERROR "orm-cxx modules support GCC, Clang, and MSVC.")
endif()
unset(orm_cxx_ninja_version)

include("${CMAKE_CURRENT_LIST_DIR}/orm-cxx-reflection-targets.cmake")
if(MSVC AND "@MSVC@")
    # CMake's imported BMI targets do not inherit MSVC_RUNTIME_LIBRARY. Apply the producer's CRT to those targets
    # without changing consumer flags.
    set(orm_cxx_module_runtime "@ORM_CXX_MODULE_MSVC_RUNTIME_LIBRARY@")
    set_property(
        TARGET orm-cxx::reflection
        APPEND
        PROPERTY IMPORTED_CXX_MODULES_COMPILE_OPTIONS
                 "$<$<STREQUAL:${orm_cxx_module_runtime},MultiThreaded>:/MT>"
                 "$<$<STREQUAL:${orm_cxx_module_runtime},MultiThreadedDebug>:/MTd>"
                 "$<$<STREQUAL:${orm_cxx_module_runtime},MultiThreadedDLL>:/MD>"
                 "$<$<STREQUAL:${orm_cxx_module_runtime},MultiThreadedDebugDLL>:/MDd>"
    )
    unset(orm_cxx_module_runtime)
endif()

check_required_components(orm-cxx-reflection)
