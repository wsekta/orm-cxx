{
  "name": "orm-cxx",
  "version": "0.5.0",
  "description": "A C++20 modules ORM with compile-time reflection and independent SQLite, PostgreSQL, MySQL, and MariaDB backends",
  "homepage": "https://github.com/wsekta/orm-cxx",
  "license": "MIT",
  "dependencies": [
    {
      "name": "soci",
      "default-features": false,
      "version>=": "4.1.0"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [],
  "features": {
    "postgresql": {
      "description": "Build the PostgreSQL backend with its client library",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "postgresql"
          ]
        }
      ]
    },
    "sqlite": {
      "description": "Build the SQLite backend",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "sqlite3"
          ]
        }
      ]
    },
    "mysql": {
      "description": "Build the mysql backend through the shared MySQL client",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "mysql"
          ]
        }
      ]
    },
    "mariadb": {
      "description": "Build the mariadb backend through the shared MySQL client",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "mysql"
          ]
        }
      ]
    }
  }
}
