{
  "name": "orm-cxx",
  "version": "0.1.0",
  "description": "A C++20 object-relational mapping library with compile-time reflection, SQLite, and PostgreSQL backends",
  "homepage": "https://github.com/wsekta/orm-cxx",
  "license": "MIT",
  "dependencies": [
    {
      "name": "soci",
      "default-features": false,
      "version>=": "4.0.3"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "sqlite"
  ],
  "features": {
    "postgresql": {
      "description": "Build the PostgreSQL backend with its client library",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "postgresql"
          ]
        }
      ]
    },
    "sqlite": {
      "description": "Build the SQLite backend",
      "dependencies": [
        {
          "name": "soci",
          "default-features": false,
          "features": [
            "sqlite3"
          ]
        }
      ]
    }
  }
}
